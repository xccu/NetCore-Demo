@page "/render-mode-webassembly"
@rendermode RenderMode.InteractiveWebAssembly
@using Services;
@inject FooService FooService

<h3>WebAssembly Render Mode</h3>
<p>RendererInfo: @RendererInfo.Name</p>
<p>IsInteractive:@RendererInfo.IsInteractive</p>
<p>@AssignedRenderMode</p>
<p>
    <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor/components/render-modes?view=aspnetcore-8.0#webassembly-render-mode">MS Document</a>
</p>
<p>@FooService.GetInfo()</p>
<button class="btn btn-primary" @onclick="UpdateMessage">Click me</button>
<button class="btn btn-primary" @onclick="WriteFile">Write file</button>
@message

@code {
    private string message = "Not clicked yet.";

    protected override void OnInitialized()
    {
        Console.WriteLine($"[{DateTime.Now}] WebAssemblyRender OnInitialized: {FooService.GetInfo()}");
    }

    private void UpdateMessage()
    {
        Console.WriteLine($"[{DateTime.Now}] WebAssemblyRender UpdateMessage clicked");
        message = "Somebody clicked me!";
    }

    private void WriteFile()
    {
        try
        {
            FooService.Save($"[{DateTime.Now}] WebAssemblyRender Write: {FooService.GetInfo()}");
            message = $"WebAssemblyRender Write: {FooService.GetInfo()}";
            Console.WriteLine(message);
        }
        catch (Exception ex)
        {
            message = ex.Message;
            Console.WriteLine(ex.Message);
        }
    }
}