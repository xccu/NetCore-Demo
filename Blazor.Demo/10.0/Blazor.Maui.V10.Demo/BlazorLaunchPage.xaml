<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Blazor.Maui.V10.Demo.BlazorLaunchPage"
             Title="BlazorLaunchPage"
             NavigationPage.HasNavigationBar="False">

        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

	<!--https://learn.microsoft.com/en-us/dotnet/maui/xaml/fundamentals/get-started?view=net-maui-9.0&source=recommendations-->

	<Button
                x:Name="NavigateBtn"
                Text="Navigate！" 
                HorizontalOptions="Center"
                Clicked="OnNavigationClicked"
                VerticalOptions="Center" />
</ContentPage>