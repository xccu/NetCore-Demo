@page "/example4"

@using Microsoft.AspNetCore.Components;
@inherits LayoutComponentBase
@using AntDesign

@inject NavigationManager Navigation

<h3>Static</h3>
<Menu Mode="MenuMode.Inline">
    <MenuItem Icon="flag"><span>Menu1</span></MenuItem>
    <SubMenu>
        <TitleTemplate>
            <span>
                <Icon Type="tool" Theme="@IconThemeType.Outline" />
                <span>Menu2</span>
            </span>
        </TitleTemplate>
        <ChildContent><MenuItem Title="Menu2-1" Icon="tool" /></ChildContent>
    </SubMenu>
    <SubMenu>
        <TitleTemplate>
            <span>
                <Icon Type="right" Theme="@IconThemeType.Outline" />
                <span>Menu3</span>
            </span>
        </TitleTemplate>
        <ChildContent>
            <MenuItem Title="Menu3-1" Icon="right" />
            <SubMenu>
                <TitleTemplate>
                    <span>
                        <Icon Type="right" Theme="@IconThemeType.Outline" />
                        <span>Menu3-2</span>
                    </span>
                </TitleTemplate>
                <ChildContent><MenuItem Title="Menu3-2-1" Icon="right" /></ChildContent>
            </SubMenu>
        </ChildContent>       
    </SubMenu>
</Menu>

<h3>Dynamic</h3>

<Menu Mode="MenuMode.Inline">
    <DynamicMenu Nodes="nodes" />
</Menu>


@code {
    private List<Node> nodes = new();

    protected override void OnInitialized()
    {
        nodes = new()
        {
            new(){ Title="Menu1",Image="flag" },
            new(){ Title="Menu2",Image="tool", ChildNodes=
            [
                new(){ Title="Menu2-1",Image="tool"},
                new(){ Title="Menu2-2",Image="right" },
            ]},
            new(){ Title="Menu3",Image="right", ChildNodes=
            [
                new(){ Title="Menu3-1",Image="right" },
                new(){ Title="Menu3-2",Image="right", ChildNodes=
                [
                    new(){ Title="Menu3-2-1",Image="right"}
                ]},
            ]},
            new(){ Title="Menu4",Image="flag" },
        };
    }



}