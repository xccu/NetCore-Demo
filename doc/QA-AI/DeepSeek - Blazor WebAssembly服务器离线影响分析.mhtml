g"></div></button></div></div></div></div></div><pre># Dockerfile
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["BlazorApp/BlazorApp.csproj", "BlazorApp/"]
COPY ["BlazorApp.Client/BlazorApp.Client.csproj", "BlazorApp.Client/"]
RUN dotnet restore "BlazorApp/BlazorApp.csproj"
COPY . .
RUN dotnet build -c Release -o /app/build

FROM build AS publish
RUN dotnet publish -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=3Dpublish /app/publish .
ENTRYPOINT ["dotnet", "BlazorApp.dll"]</pre><svg xmlns=3D"http://www.w3.org=
