=B7 @user.Name&lt;/a&gt;
        &lt;button @onclick=3D"() =3D&gt; NavigateToUser(user.Id)"&gt;
            =E7=BC=96=E7=A8=8B=E5=BC=8F=E8=B7=B3=E8=BD=AC
        &lt;/button&gt;
    &lt;/div&gt;
}

@code {
    private List&lt;User&gt; users =3D new()
    {
        new User { Id =3D 1, Name =3D "=E5=BC=A0=E4=B8=89" },
        new User { Id =3D 2, Name =3D "=E6=9D=8E=E5=9B=9B" }
    };
   =20
    [Inject] NavigationManager Navigation { get; set; }
   =20
    private void NavigateToUser(int userId)
